{
  "name": "gameguides",
  "version": "1.0.0",
  "description": "Poradniki do gier w eleganckim PDF",
  "author": "pr3ston1989",
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder --win nsis portable",
    "icons": "node scripts/icons.cjs",
    "smoke": "electron . --smoke"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "robots-parser": "^3.0.1",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "pl.gameguides.desktop",
    "productName": "GameGuides",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "GameGuides-${version}-Portable.${ext}"
    },
    "nsis": {
      "artifactName": "GameGuides-${version}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GameGuides",
      "installerLanguages": [
        "pl_PL",
        "en_US"
      ]
    }
  }
}
