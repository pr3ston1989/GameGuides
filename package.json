{
  "name": "gameguides",
  "version": "1.2.1",
  "description": "Poradniki do gier w eleganckim PDF",
  "author": "pr3ston1989",
  "license": "MIT",
  "main": "src/entry.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build": "electron-builder --win nsis portable",
    "icons": "node scripts/icons.cjs",
    "smoke": "electron . --smoke",
    "test:ui": "electron scripts/ui-check.cjs",
    "test:live": "node scripts/site-sample.cjs",
    "test:browser": "electron scripts/site-sample-browser.cjs",
    "test:pdf": "electron scripts/qa-pdf.cjs",
    "test:render": "node scripts/render-qa.cjs",
    "test:full": "electron scripts/full-guide-check.cjs",
    "test:media": "electron scripts/file-assets-check.cjs"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "robots-parser": "^3.0.1",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "png-to-ico": "^3.0.1"
  },
  "build": {
    "appId": "pl.gameguides.desktop",
    "productName": "GameGuides",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "GameGuides-${version}-Portable.${ext}"
    },
    "nsis": {
      "artifactName": "GameGuides-${version}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GameGuides",
      "installerLanguages": [
        "pl_PL",
        "en_US"
      ]
    }
  }
}
